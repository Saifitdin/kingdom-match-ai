# DashScope (Qwen) — для AI-генерации уровней и диалогов NPC
# Без этого ключа AI-модули работают на шаблонах (fallback)
DASHSCOPE_API_KEY=sk-ваш_ключ_от_dashscope
DASHSCOPE_MODEL=qwen-plus

# Replicate — для генерации игровой графики (Flux/SDXL)
# Получить: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_ваш_токен_replicate

# Порт сервера (по умолчанию 5050)
KM_AI_PORT=5050

# Режим отладки (0/1)
KM_AI_DEBUG=0
