# ===== LLM (OpenAI-совместимый: DeepSeek / Qwen / OpenAI / любой) =====
# DeepSeek (по умолчанию)
DEEPSEEK_API_KEY=sk-ваш_ключ_от_deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Альтернативы (раскомментируй нужное):
# Qwen / DashScope:
# AI_API_KEY=sk-ваш_ключ_qwen
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
# OpenAI:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ===== Replicate (генерация графики Flux/SDXL) =====
# Получить: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_ваш_токен_replicate

# ===== Server =====
KM_AI_PORT=5050
KM_AI_DEBUG=0
KM_COMIC_IMAGES=0
